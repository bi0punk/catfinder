# CatFinder RTSP Monitor - configuración optimizada CPU/RAM
# Copia este archivo como .env y ajusta tus datos.

# --- Cámaras RTSP ---
# Formato: nombre=url,nombre2=url2
# Usa substream cuando exista. En Hikvision suele ser Streaming/Channels/102.
# El nombre solo admite letras, números, guion y guion_bajo.
RTSP_URLS=
# Archivo YAML alternativo (opcional). Por defecto: config/cameras.yaml
# CAMERAS_FILE=config/cameras.yaml

# --- Modelo YOLO ---
# Recomendado: montar ./models:/models y usar /models/yolo11n.pt
# El binario .pt NO se commitea (ver README). Descarga: yolo predict model=yolo11n.pt
MODEL_PATH=models/yolo11n.pt
TARGET_CLASSES=cat
# Perfil ajustado para gatos pequeños/parciales/nocturnos en cámaras RTSP
CONFIDENCE_THRESHOLD=0.25
INFER_IMGSZ=640
DETECT_FPS=1.0
MAX_FRAME_WIDTH=1280
BOX_PERSIST_SECONDS=2.5
MIN_BOX_AREA_RATIO=0.0
DRAW_BOXES=true
COOLDOWN_SECONDS=60
DETECTOR_DEVICE=cpu
JPEG_QUALITY=75

# --- Recursos (OpenCV / Torch / BLAS) ---
OPENCV_THREADS=1
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
NUMEXPR_NUM_THREADS=2
TORCH_NUM_THREADS=2
TORCH_INTEROP_THREADS=1

# --- RTSP ---
RTSP_BUFFER_SIZE=1
RTSP_OPEN_TIMEOUT_MS=5000
RTSP_READ_TIMEOUT_MS=5000
RECONNECT_DELAY_SECONDS=5
RECONNECT_DELAY_MAX_SECONDS=60
OPENCV_FFMPEG_CAPTURE_OPTIONS=rtsp_transport;tcp|stimeout;5000000|max_delay;500000

# --- Evidencias ---
SAVE_DIR=captures
RETENTION_DAYS=14
MAX_EVENTS_MEMORY=200

# --- Telegram (opcional) ---
# Requiere token y chat_id; si faltan, Telegram queda desactivado.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REQUEST_TIMEOUT_SECONDS=20
TELEGRAM_QUEUE_SIZE=50

# --- Web ---
# Default seguro: solo accesible localmente.
# Si usas WEB_HOST=0.0.0.0 define SIEMPRE WEB_PASSWORD.
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_TITLE=CatFinder RTSP Monitor
WEB_PASSWORD=

# --- Logs ---
LOG_LEVEL=INFO
